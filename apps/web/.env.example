# Network selection: local | base-sepolia | base
VITE_HAWK_NETWORK=base
# Public indexer GraphQL endpoint (names lists, search-by-owner, auctions).
# Resolution + registration work over RPC without it.
VITE_INDEXER_URL=https://api.dothawk.xyz
# Optional: WalletConnect project id (enables the WalletConnect connector).
VITE_WC_PROJECT_ID=
# Dark-launch: set to 1 to enable the agent directory + verify UI
# (requires HAWK_AGENT_API=1 on the indexer).
VITE_HAWK_AGENTS=
