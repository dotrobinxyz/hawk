# Network selection: local | robinhood-testnet | robinhood
VITE_ROBIN_NETWORK=robinhood-testnet
# Public indexer GraphQL endpoint (names lists, search-by-owner, auctions).
# Resolution + registration work over RPC without it.
VITE_INDEXER_URL=https://api.dotrobin.xyz
# Optional: WalletConnect project id (enables the WalletConnect connector).
VITE_WC_PROJECT_ID=
